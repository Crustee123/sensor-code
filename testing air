  String json = "{";

  json += "\"sensor_id\":\"" + String(sensorID) + "\",";
  json += "\"date\":\"" + currentDate + "\",";
  json += "\"time\":\"" + currentTime + "\",";
  json += "\"timestamp\":" + String(currentTimestamp) + ",";
  json += "\"water_level\":" + String(waterHeight, 2);

  json += "}";

  return json;
}

// ==================================================
// FIREBASE HTTP POST THROUGH AIR780E
// ==================================================

bool uploadHTTP(
  String url,
  String json,
  int expectedStatus = 200
) {

  Serial.println();
  Serial.println("========== AIR780E HTTP UPLOAD ==========");

  // Close any previous HTTP session.
  sendAT("AT+HTTPTERM", 3000);

  if (!sendAT("AT+HTTPINIT")) {
    return false;
  }

  if (!sendAT("AT+HTTPSSL=1")) {
    sendAT("AT+HTTPTERM");
    return false;
  }

  if (!sendAT("AT+HTTPPARA=\"CID\",1")) {
    sendAT("AT+HTTPTERM");
    return false;
  }

  // Configure URL.

  String urlCommand =
    "AT+HTTPPARA=\"URL\",\"";

  urlCommand += url;
  urlCommand += "\"";

  if (!sendAT(urlCommand, 15000)) {
    sendAT("AT+HTTPTERM");
    return false;
  }

  // Configure JSON content.

  if (!sendAT(
    "AT+HTTPPARA=\"CONTENT\",\"application/json\""
  )) {
    sendAT("AT+HTTPTERM");
    return false;
  }

  // Tell modem how many bytes to receive.

  String dataCommand =
    "AT+HTTPDATA=" +
    String(json.length()) +
    ",10000";

  Serial.println();
  Serial.println(">> " + dataCommand);

  airSerial.println(dataCommand);

  String downloadResponse;

  if (!waitForToken(
    "DOWNLOAD",
    12000,
    downloadResponse
  )) {

    Serial.println("DOWNLOAD prompt missing!");

    sendAT("AT+HTTPTERM");

    return false;
  }

  // Send JSON body.

  Serial.println("\nSending JSON:");

  Serial.println(json);

  airSerial.print(json);

  String dataResponse;

  if (!waitForToken(
    "OK",
    15000,
    dataResponse
  )) {

    Serial.println("JSON transmission failed!");

    sendAT("AT+HTTPTERM");

    return false;
  }

  Serial.println("\nJSON accepted by AIR780E.");

  // Perform POST.

  Serial.println("\nStarting HTTP POST...");

  airSerial.println("AT+HTTPACTION=1");

  String actionOK;

  if (!waitForToken("OK", 10000, actionOK)) {

    Serial.println("HTTPACTION command failed!");

    sendAT("AT+HTTPTERM");

    return false;
  }

  // Wait for asynchronous HTTP result.

  String actionResponse;

  if (!waitForToken(
    "+HTTPACTION:",
    60000,
    actionResponse
  )) {

    Serial.println("HTTP ACTION timed out!");

    sendAT("AT+HTTPTERM");

    return false;
  }

  // Read the rest of the HTTPACTION line.

  unsigned long lineStart = millis();

  while (millis() - lineStart < 3000) {

    while (airSerial.available()) {

      char c = airSerial.read();

      Serial.write(c);

      actionResponse += c;

      if (c == '\n') {
        break;
      }
    }

    if (actionResponse.endsWith("\n")) {
      break;
    }

    yield();
  }

  // Extract HTTP status.

  int firstComma = actionResponse.indexOf(',');
  int secondComma =
    actionResponse.indexOf(',', firstComma + 1);

  int httpStatus = 0;

  if (firstComma >= 0 && secondComma > firstComma) {

    httpStatus = actionResponse.substring(
      firstComma + 1,
      secondComma
    ).toInt();
  }

  Serial.println();

  Serial.print("HTTP STATUS: ");
  Serial.println(httpStatus);

  // Read Firebase response.

  Serial.println("\nReading Firebase response...");

  String readResponse;

  sendAT("AT+HTTPREAD", 15000, &readResponse);

  sendAT("AT+HTTPTERM", 5000);

  if (httpStatus == expectedStatus) {

    Serial.println("\nFIREBASE UPLOAD SUCCESSFUL!");

    return true;
  }

  Serial.println("\nFIREBASE UPLOAD FAILED!");

  return false;
}

// ==================================================
// FIREBASE UPLOAD
// ==================================================

void uploadFirebase() {

  Serial.println();
  Serial.println("================================");
  Serial.println("       FIREBASE UPLOAD");
  Serial.println("================================");

  if (!timeValid) {

    Serial.println("Time unavailable. Trying NTP...");

    if (!syncNetworkTime()) {

      Serial.println("Time sync failed; skipping upload.");

      return;
    }
  }

  String currentJSON = createCurrentJSON();

  String historyJSON = createHistoryJSON();

  // ================================================
  // 1. UPDATE LATEST SENSOR READING
  // ================================================

  Serial.println();
  Serial.println("UPDATING CURRENT SENSOR DATA...");

  String currentURL =
    String(firebaseURL) +
    "/flood_details/" +
    String(sensorID) +
    ".json?x-http-method-override=PUT";

  bool currentSuccess = uploadHTTP(
    currentURL,
    currentJSON
  );

  // ================================================
  // 2. SAVE HISTORY
  // ================================================

  Serial.println();
  Serial.println("SAVING WATER LEVEL HISTORY...");

  String historyURL =
    String(firebaseURL) +
    "/water_level_history.json";

  bool historySuccess = uploadHTTP(
    historyURL,
    historyJSON
  );

  // ================================================

  Serial.println();
  Serial.println("========== UPLOAD SUMMARY ==========");

  Serial.print("Current Data: ");
  Serial.println(currentSuccess ? "SUCCESS" : "FAILED");

  Serial.print("History Data: ");
  Serial.println(historySuccess ? "SUCCESS" : "FAILED");
}

// ==================================================
// LOCAL WEB DASHBOARD
// ==================================================

void handleWebServer() {

  WiFiClient client = server.available();

  if (!client) {
    return;
  }

  unsigned long timeout = millis();

  while (client.connected() && !client.available()) {

    delay(1);

    if (millis() - timeout > 2000) {

      client.stop();

      return;
    }
  }

  client.readStringUntil('\r');

  client.println("HTTP/1.1 200 OK");
  client.println("Content-Type: text/html");
  client.println("Connection: close");
  client.println();

  client.println("<!DOCTYPE html>");
  client.println("<html>");
  client.println("<head>");

  client.println(
    "<meta name='viewport' content='width=device-width, initial-scale=1'>"
  );

  client.println("<meta http-equiv='refresh' content='2'>");
  client.println("<title>FloodWatch</title>");

  client.println("</head>");

  client.println(
    "<body style='text-align:center;font-family:Arial;"
    "background:#0B0F5B;color:white;'>"
  );

  client.println("<h1>FloodWatch Sensor</h1>");

  client.print("<h2>Distance: ");
  client.print(distance, 2);
  client.println(" cm</h2>");

  client.print("<h2>Water Level: ");
  client.print(waterHeight, 2);
  client.println(" cm</h2>");

  client.print("<h2>Flood Type: ");
  client.print(floodType);
  client.println("</h2>");

  client.print("<h3>Date: ");
  client.print(currentDate);
  client.println("</h3>");

  client.print("<h3>Time: ");
  client.print(currentTime);
  client.println("</h3>");

  client.print("<h3>Cellular Time: ");
  client.print(timeValid ? "Synchronized" : "Not synchronized");
  client.println("</h3>");

  client.println("</body>");
  client.println("</html>");

  client.stop();
}

// ==================================================
// SETUP
// ==================================================

void setup() {

  Serial.begin(115200);

  airSerial.begin(9600);

  delay(2000);

  airSerial.println("AT");
  delay(1000);

  while (airSerial.available()) {
  Serial.write(airSerial.read());
  }

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);

  digitalWrite(TRIG, LOW);

  Serial.println();
  Serial.println("================================");
  Serial.println("       FLOODWATCH SYSTEM");
  Serial.println("================================");

  // ================================================
  // START LOCAL ESP8266 ACCESS POINT
  // ================================================

  WiFi.mode(WIFI_AP);

  WiFi.softAP(apName, apPassword);

  Serial.println();
  Serial.println("LOCAL DASHBOARD STARTED");

  Serial.print("WiFi Name: ");
  Serial.println(apName);

  Serial.print("Dashboard IP: ");
  Serial.println(WiFi.softAPIP());

  server.begin();

  // ================================================
  // CHECK AIR780E
  // ================================================

  Serial.println();
  Serial.println("Checking AIR780E...");

  String modemResponse;

  bool modemReady = false;

  for (int i = 0; i < 5; i++) {

    if (sendAT("AT", 3000)) {

      modemReady = true;

      break;
    }

    delay(1000);
  }

  if (!modemReady) {

    Serial.println("AIR780E NOT RESPONDING!");

    Serial.println("Check UART wiring and power.");

    return;
  }

  Serial.println();
  Serial.println("AIR780E READY!");

  // ================================================
  // SYNCHRONIZE MODEM TIME
  // ================================================

  syncNetworkTime();

  previousTimeSync = millis();

  Serial.println();
  Serial.println("================================");
  Serial.println("       SYSTEM READY");
  Serial.println("================================");
}

// ==================================================
// LOOP
// ==================================================

void loop() {

  // ================================================
  // SENSOR READING
  // ================================================

  if (millis() - previousSensorRead >= sensorInterval) {

    previousSensorRead = millis();

    sensorValid = readSensor();

    if (sensorValid) {
      classifyFlood();
    }
  }

  // ================================================
  // NETWORK TIME RESYNC
  // ================================================

  if (millis() - previousTimeSync >= timeSyncInterval) {

    previousTimeSync = millis();

    syncNetworkTime();
  }

  // ================================================
  // FIREBASE UPLOAD
  // ================================================

  if (millis() - previousUpload >= uploadInterval) {

    previousUpload = millis();

    if (sensorValid) {

      uploadFirebase();

    }
    else {

      Serial.println(
        "Upload skipped: No valid sensor reading."
      );
    }
  }

  // ================================================
  // LOCAL DASHBOARD
  // ================================================

  handleWebServer();

  yield();
}
