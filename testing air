// ==================================================
// MODEM RESPONSE READER
// ==================================================

bool waitForToken(
  String token,
  unsigned long timeout,
  String &response
) {

  response = "";

  unsigned long start = millis();

  while (millis() - start < timeout) {

    while (airSerial.available()) {

      char c = airSerial.read();

      Serial.write(c);

      response += c;

      if (response.indexOf(token) >= 0) {
        return true;
      }

      if (response.length() > 2000) {
        response.remove(0, 1000);
      }
    }

    yield();
  }

  return false;
}

// ==================================================
// SEND AT COMMAND
// ==================================================

bool sendAT(
  String command,
  unsigned long timeout = 8000,
  String *output = nullptr
) {

  Serial.println();
  Serial.println(">> " + command);

  airSerial.println(command);

  String response;

  bool received = waitForToken("OK", timeout, response);

  if (output != nullptr) {
    *output = response;
  }

  if (!received ||
      response.indexOf("ERROR") >= 0) {

    Serial.println("\nAT COMMAND FAILED!");

    return false;
  }

  return true;
}

// ==================================================
// MODEM TIME SYNCHRONIZATION
// ==================================================

int64_t daysFromCivil(int year, unsigned month, unsigned day) {

  year -= (month <= 2);

  int era = (year >= 0 ? year : year - 399) / 400;

  unsigned yearOfEra = year - era * 400;

  int adjustedMonth =
    (int)month + (month > 2 ? -3 : 9);

  unsigned dayOfYear =
    (153 * adjustedMonth + 2) / 5 + day - 1;

  unsigned dayOfEra =
    yearOfEra * 365 +
    yearOfEra / 4 -
    yearOfEra / 100 +
    dayOfYear;

  return (int64_t)era * 146097 +
         (int64_t)dayOfEra - 719468;
}

// --------------------------------------------------

bool readModemClock() {

  String response;

  if (!sendAT("AT+CCLK?", 5000, &response)) {
    return false;
  }

  int position = response.indexOf("+CCLK:");

  if (position < 0) {
    Serial.println("Clock response missing!");
    return false;
  }

  int quoteStart = response.indexOf('"', position);
  int quoteEnd = response.indexOf('"', quoteStart + 1);

  if (quoteStart < 0 || quoteEnd < 0) {
    return false;
  }

  String clock = response.substring(
    quoteStart + 1,
    quoteEnd
  );

  if (clock.length() < 20) {
    return false;
  }

  int year = 2000 + clock.substring(0, 2).toInt();

  int month = clock.substring(3, 5).toInt();
  int day = clock.substring(6, 8).toInt();

  int hour = clock.substring(9, 11).toInt();
  int minute = clock.substring(12, 14).toInt();
  int second = clock.substring(15, 17).toInt();

  int timezoneQuarter =
    clock.substring(18, 20).toInt();

  if (clock.charAt(17) == '-') {
    timezoneQuarter = -timezoneQuarter;
  }

  if (year < 2024 ||
      month < 1 || month > 12 ||
      day < 1 || day > 31 ||
      hour > 23 ||
      minute > 59 ||
      second > 59) {

    Serial.println("Invalid modem clock!");
    return false;
  }

  const char* months[] = {
    "January", "February", "March",
    "April", "May", "June",
    "July", "August", "September",
    "October", "November", "December"
  };

  currentDate =
    String(months[month - 1]) + " " +
    String(day) + ", " +
    String(year);

  char timeBuffer[20];

  int displayHour = hour % 12;

  if (displayHour == 0) {
    displayHour = 12;
  }

  sprintf(
    timeBuffer,
    "%02d:%02d:%02d %s",
    displayHour,
    minute,
    second,
    hour >= 12 ? "PM" : "AM"
  );

  currentTime = String(timeBuffer);

  int64_t epoch =
    daysFromCivil(year, month, day) * 86400LL +
    hour * 3600LL +
    minute * 60LL +
    second -
    timezoneQuarter * 900LL;

  currentTimestamp = (uint32_t)epoch;

  timeValid = true;

  Serial.println();
  Serial.println("MODEM TIME UPDATED");

  Serial.println(currentDate);
  Serial.println(currentTime);

  Serial.print("Timestamp: ");
  Serial.println(currentTimestamp);

  return true;
}

// --------------------------------------------------

bool syncNetworkTime() {

  Serial.println();
  Serial.println("========== NETWORK TIME SYNC ==========");

  if (!sendAT("AT+CNTPCID=1")) {
    return false;
  }

  // Philippines = UTC+8 = 32 quarter-hours

  if (!sendAT(
    "AT+CNTP=\"pool.ntp.org\",32"
  )) {
    return false;
  }

  Serial.println("\nRequesting NTP synchronization...");

  airSerial.println("AT+CNTP");

  String response;

  bool commandOK = waitForToken(
    "OK",
    10000,
    response
  );

  if (!commandOK) {
    Serial.println("NTP command failed.");
    return false;
  }

  String ntpResponse;

  bool synced = waitForToken(
    "+CNTP:",
    30000,
    ntpResponse
  );

  if (!synced) {
    Serial.println("NTP response timed out.");
    return false;
  }

  if (ntpResponse.indexOf("+CNTP: 1") < 0) {
    Serial.println("NTP synchronization unsuccessful.");
    return false;
  }

  return readModemClock();
}

// ==================================================
// SENSOR
// ==================================================

bool readSensor() {

  digitalWrite(TRIG, LOW);
  delayMicroseconds(5);

  digitalWrite(TRIG, HIGH);
  delayMicroseconds(10);

  digitalWrite(TRIG, LOW);

  unsigned long duration =
    pulseIn(ECHO, HIGH, 35000);

  if (duration == 0) {

    Serial.println("Sensor Timeout!");

    return false;
  }

  float newDistance =
    duration * 0.0343 / 2.0;

  if (newDistance <= 2 ||
      newDistance > SENSOR_HEIGHT) {

    Serial.println("Invalid Sensor Reading!");

    return false;
  }

  distance = newDistance;

  waterHeight = SENSOR_HEIGHT - distance;

  Serial.println();
  Serial.println("========== SENSOR READING ==========");

  Serial.print("Distance: ");
  Serial.print(distance, 2);
  Serial.println(" cm");

  Serial.print("Water Level: ");
  Serial.print(waterHeight, 2);
  Serial.println(" cm");

  return true;
}

// ==================================================
// FLOOD CLASSIFICATION
// ==================================================

void classifyFlood() {

  if (waterHeight <= 10) {

    floodType = "No Flood";

  }
  else if (waterHeight <= 20) {

    floodType = "Light Flooding";

  }
  else if (waterHeight <= 35) {

    floodType = "Flooding";

  }
  else {

    floodType = "Heavy Flooding";

  }

  Serial.print("Flood Type: ");
  Serial.println(floodType);
}

