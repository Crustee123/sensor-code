bool timeIsValid() { return time(nullptr) > 100000; }

String getDate() {
  if (!timeIsValid()) return "Time unavailable";
  time_t now = time(nullptr); struct tm timeinfo; localtime_r(&now, &timeinfo);
  char buffer[30]; strftime(buffer, sizeof(buffer), "%B %d, %Y", &timeinfo);
  return String(buffer);
}

String getTime() {
  if (!timeIsValid()) return "Time unavailable";
  time_t now = time(nullptr); struct tm timeinfo; localtime_r(&now, &timeinfo);
  char buffer[20]; strftime(buffer, sizeof(buffer), "%I:%M:%S %p", &timeinfo);
  return String(buffer);
}

unsigned long getTimestamp() {
  if (!timeIsValid()) return 0;
  return (unsigned long)time(nullptr);
}

void syncTimeIfWiFiAvailable() {
  if (WiFi.status() != WL_CONNECTED || timeIsValid()) return;
  configTime(28800, 0, "pool.ntp.org", "time.google.com");
  uint32_t start = millis();
  while (!timeIsValid() && millis() - start < 12000UL) { delay(250); yield(); }
  Serial.println(timeIsValid() ? "Time synchronized." : "NTP time unavailable; timestamp will be 0 until synced.");
}

// ============================================================
// BATTERY MONITORING
// ============================================================
float readBatteryVoltage() {
  long total = 0;
  for (int i = 0; i < 20; i++) { total += analogRead(BATTERY_PIN); delay(5); }
  float raw = total / 20.0;
  float adcVoltage = raw * (ADC_FULL_SCALE / 1023.0);
  return adcVoltage * DIVIDER_RATIO;
}

int calculateBatteryPercentage(float voltage) {
  if (voltage >= 4.20) return 100;
  if (voltage >= 4.10) return 90;
  if (voltage >= 4.00) return 80;
  if (voltage >= 3.90) return 60;
  if (voltage >= 3.80) return 40;
  if (voltage >= 3.70) return 20;
  if (voltage >= 3.50) return 5;
  return 0;
}

void updateChargingStatus(float voltage) {
  if (previousBatteryVoltage == 0) {
    previousBatteryVoltage = voltage; chargingStatus = "Checking"; previousTrendCheck = millis(); return;
  }
  if (millis() - previousTrendCheck >= trendCheckInterval) {
    voltageTrend = voltage - previousBatteryVoltage;
    if (voltageTrend > 0.02) chargingStatus = "Probably Charging";
    else if (voltageTrend < -0.02) chargingStatus = "Discharging";
    else chargingStatus = "Stable";
    previousBatteryVoltage = voltage;
    previousTrendCheck = millis();
  }
}

void uploadBatteryData() {
  batteryVoltage = readBatteryVoltage();
  batteryPercentage = calculateBatteryPercentage(batteryVoltage);
  updateChargingStatus(batteryVoltage);
  String json = "{";
  json += "\"voltage\":" + String(batteryVoltage, 2) + ",";
  json += "\"percentage\":" + String(batteryPercentage) + ",";
  json += "\"charging_status\":\"" + jsonEscape(chargingStatus) + "\",";
  json += "\"charging_trend\":" + String(voltageTrend, 3) + ",";
  json += "\"last_updated\":" + String(getTimestamp());
  json += "}";
  String response;
  Serial.println("\n========== BATTERY UPLOAD ==========");
  Serial.println("Voltage: " + String(batteryVoltage, 2) + " V | " + String(batteryPercentage) + "% | " + chargingStatus);
  bool ok = firebaseRequest("PUT", batteryURL, json, response);
  Serial.println(ok ? "Battery Firebase upload SUCCESS" : "Battery Firebase upload FAILED: " + lastError);
}

