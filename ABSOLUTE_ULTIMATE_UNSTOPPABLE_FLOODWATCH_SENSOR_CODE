// SENSOR SETTINGS
// ============================================================
float getSetting(String json, String key, float fallback) {
  String searchKey = "\"" + key + "\"";
  int keyPosition = json.indexOf(searchKey);
  if (keyPosition < 0) return fallback;
  int colonPosition = json.indexOf(":", keyPosition);
  if (colonPosition < 0) return fallback;
  int start = colonPosition + 1;
  while (start < (int)json.length() && (json[start] == ' ' || json[start] == '\n' || json[start] == '\r')) start++;
  int end = start;
  while (end < (int)json.length() && json[end] != ',' && json[end] != '}') end++;
  String value = json.substring(start, end); value.trim();
  if (!value.length() || value == "null") return fallback;
  return value.toFloat();
}

void fetchSensorSettings() {
  String json;
  Serial.println("\nFetching Firebase sensor settings...");
  if (!firebaseRequest("GET", settingsURL, "", json)) {
    Serial.println("Settings fetch failed: " + lastError);
    return;
  }
  Serial.println("Settings JSON: " + json);
  float newHeight = getSetting(json, "tube_height_cm", SENSOR_HEIGHT);
  float newLight = getSetting(json, "light_flooding_cm", LIGHT_FLOODING_LEVEL);
  float newFlood = getSetting(json, "flooding_cm", FLOODING_LEVEL);
  float newHeavy = getSetting(json, "heavy_flooding_cm", HEAVY_FLOODING_LEVEL);
  if (newHeight > newHeavy && newHeavy > newFlood && newFlood > newLight && newLight > 0) {
    SENSOR_HEIGHT = newHeight;
    LIGHT_FLOODING_LEVEL = newLight;
    FLOODING_LEVEL = newFlood;
    HEAVY_FLOODING_LEVEL = newHeavy;
    Serial.println("Sensor settings updated from Firebase.");
  } else {
    Serial.println("Settings missing/invalid; keeping current values.");
  }
  Serial.println("Tube=" + String(SENSOR_HEIGHT) + " cm | Light=" + String(LIGHT_FLOODING_LEVEL) +
                 " cm | Flood=" + String(FLOODING_LEVEL) + " cm | Heavy=" + String(HEAVY_FLOODING_LEVEL) + " cm");
}

// ============================================================
// SENSOR READING AND FLOOD CLASSIFICATION
// ============================================================
bool readSensor() {
  digitalWrite(TRIG, LOW); delayMicroseconds(5);
  digitalWrite(TRIG, HIGH); delayMicroseconds(10);
  digitalWrite(TRIG, LOW);
  unsigned long duration = pulseIn(ECHO, HIGH, 35000);
  if (duration == 0) { Serial.println("Sensor Timeout!"); return false; }
  float newDistance = duration * 0.0343 / 2.0;
  if (newDistance <= 2 || newDistance > SENSOR_HEIGHT) { Serial.println("Invalid Sensor Reading!"); return false; }
  distance = newDistance;
  waterHeight = SENSOR_HEIGHT - distance;
  Serial.println("\n========== SENSOR ==========");
  Serial.println("Distance: " + String(distance, 2) + " cm");
  Serial.println("Water Level: " + String(waterHeight, 2) + " cm");
  return true;
}

void classifyFlood() {
  if (waterHeight < LIGHT_FLOODING_LEVEL) floodType = "No Flood";
  else if (waterHeight < FLOODING_LEVEL) floodType = "Light Flooding";
  else if (waterHeight < HEAVY_FLOODING_LEVEL) floodType = "Flooding";
  else floodType = "Heavy Flooding";
  Serial.println("Flood Type: " + floodType);
}

// ============================================================
// FIREBASE SENSOR CURRENT + HISTORY UPLOAD
// ============================================================
void uploadFirebase() {
  String currentJSON = "{";
  currentJSON += "\"date\":\"" + jsonEscape(getDate()) + "\",";
  currentJSON += "\"time\":\"" + jsonEscape(getTime()) + "\",";
  currentJSON += "\"timestamp\":" + String(getTimestamp()) + ",";
  currentJSON += "\"flood_type\":\"" + jsonEscape(floodType) + "\",";
  currentJSON += "\"location\":\"" + jsonEscape(location) + "\",";
  currentJSON += "\"water_level\":" + String(waterHeight, 2);
  currentJSON += "}";

  String response;
  Serial.println("\n========== CURRENT SENSOR UPLOAD ==========");
  Serial.println(currentJSON);
  bool currentOK = firebaseRequest("PUT", currentURL, currentJSON, response);
  Serial.println(currentOK ? "Current sensor data UPDATED." : "Current sensor upload FAILED: " + lastError);

  yield();

  String historyJSON = "{";
  historyJSON += "\"sensor_id\":\"" + String(sensorID) + "\",";
  historyJSON += "\"date\":\"" + jsonEscape(getDate()) + "\",";
  historyJSON += "\"time\":\"" + jsonEscape(getTime()) + "\",";
  historyJSON += "\"timestamp\":" + String(getTimestamp()) + ",";
  historyJSON += "\"water_level\":" + String(waterHeight, 2);
  historyJSON += "}";
  Serial.println("Uploading water-level history...");
  bool historyOK = firebaseRequest("POST", historyURL, historyJSON, response);
  Serial.println(historyOK ? "History saved." : "History upload FAILED: " + lastError);

  bool overall = currentOK && historyOK;
  firebaseConnected = overall;
  if (overall) {
    lastUpload = "SUCCESS - " + activeConnection;
    lastError = "None";
  } else {
    lastUpload = "PARTIAL/FAILED - " + activeConnection;
  }
  uploadCounter++;
}

// ============================================================
// LOCAL WEB DASHBOARD
// ============================================================
void handleWebServer() {
  WiFiClient c = server.available();
  if (!c) return;
  unsigned long started = millis();
  while (c.connected() && !c.available() && millis() - started < 1500) { delay(1); yield(); }
  if (!c.available()) { c.stop(); return; }
  c.readStringUntil('\r');
  c.println("HTTP/1.1 200 OK\r\nContent-Type: text/html; charset=utf-8\r\nConnection: close\r\n");
  c.println("<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'><meta http-equiv='refresh' content='3'><title>FloodWatch</title></head>");
