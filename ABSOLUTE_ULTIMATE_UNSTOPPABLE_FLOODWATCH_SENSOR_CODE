  c.println("<p><b>Sensor:</b> " + String(sensorID) + "</p>");
  c.println("<p><b>Distance:</b> " + String(distance, 2) + " cm</p>");
  c.println("<p><b>Water level:</b> " + String(waterHeight, 2) + " cm</p>");
  c.println("<p><b>Flood type:</b> " + floodType + "</p><hr>");
  c.println("<h3>Battery</h3><p>Voltage: " + String(batteryVoltage, 2) + " V</p>");
  c.println("<p>Battery: " + String(batteryPercentage) + "%</p><p>Charging: " + chargingStatus + "</p><hr>");
  c.println("<h3>Cellular / SIM</h3><p>Carrier: " + carrier + "</p>");
  c.println("<p>SIM: " + String(simDetected ? "DETECTED" : "NOT READY") + "</p>");
  c.println("<p>Signal: " + signalQuality + " (~" + String(signalPercent) + "%)</p>");
  c.println("<p>LTE: " + registrationStatus + "</p><p>Packet attached: " + String(packetAttached ? "YES" : "NO") + "</p>");
  c.println("<p>Modem IP: " + modemIP + "</p><p>PDP bearer: " + String(bearerActive ? "ACTIVE" : "INACTIVE") + "</p>");
  c.println("<p>Cellular: " + String(cellularConnected ? "AVAILABLE" : "UNAVAILABLE") + "</p><hr>");
  c.println("<h3>Wi-Fi Backup</h3><p>Wi-Fi: " + String(WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED") + "</p>");
  if (WiFi.status() == WL_CONNECTED) c.println("<p>Connected Wi-Fi: " + WiFi.SSID() + "</p>");
  c.println("<p>Active connection: " + activeConnection + "</p><p>Firebase: " + String(firebaseConnected ? "SUCCESS" : "NOT CONFIRMED") + "</p>");
  c.println("<p>Last upload: " + lastUpload + "</p><p>HTTP status: " + String(lastHTTPStatus) + "</p>");
  c.println("<p>Last error: " + lastError + "</p><p>Last modem URC: " + lastModemURC + "</p><hr>");
  c.println("<h3>Sensor Configuration</h3><p>Tube height: " + String(SENSOR_HEIGHT) + " cm</p>");
  c.println("<p>Light flooding: " + String(LIGHT_FLOODING_LEVEL) + " cm</p><p>Flooding: " + String(FLOODING_LEVEL) + " cm</p>");
  c.println("<p>Heavy flooding: " + String(HEAVY_FLOODING_LEVEL) + " cm</p>");
  c.println("<p>Uptime: " + String(millis() / 1000) + " seconds</p>");
  c.println("</body></html>");
  c.stop();
}

// ============================================================
// SETUP
// ============================================================
void setup() {
  Serial.begin(115200);
  airSerial.begin(MODEM_BAUD);
  delay(1200);

  pinMode(TRIG, OUTPUT);
  pinMode(ECHO, INPUT);
  pinMode(BATTERY_PIN, INPUT);
  digitalWrite(TRIG, LOW);

  Serial.println("\n============================================");
  Serial.println(" FLOODWATCH - ABSOLUTE FINAL SENSOR CODE");
  Serial.println(" Cellular primary | Dual Wi-Fi backup");
  Serial.println("============================================");

  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleepMode(WIFI_NONE_SLEEP);
  WiFi.softAP(AP_NAME, AP_PASSWORD);
  server.begin();
  Serial.println("Dashboard AP: " + String(AP_NAME));
  Serial.println("Dashboard IP: " + WiFi.softAPIP().toString());

  wifiMulti.addAP(WIFI_SSID_1, WIFI_PASSWORD_1);
  wifiMulti.addAP(WIFI_SSID_2, WIFI_PASSWORD_2);
  Serial.println("Wi-Fi backup networks registered:");
  Serial.println("1. " + String(WIFI_SSID_1));
  Serial.println("2. " + String(WIFI_SSID_2));
  wifiMulti.run();

  bool modemReady = false;
  for (int i = 0; i < 10; i++) {
    if (sendAT("AT", 2500)) { modemReady = true; break; }
    delay(800);
  }
  if (modemReady) {
    Serial.println("AIR780E RESPONDING");
    sendAT("ATE0", 4000);
    sendAT("AT+CMEE=2", 4000);
    sendAT("AT+CEREG=2", 4000);
    updateCellularDiagnostics();
  } else {
    lastError = "AIR780E not responding at 9600 baud";
    Serial.println(lastError);
  }

  // NTP uses Wi-Fi if available. Cellular-only operation can still upload,
  // but timestamps remain 0 until the ESP8266 obtains valid time.
  syncTimeIfWiFiAvailable();

  fetchSensorSettings();
  previousSettingsFetch = millis();

  batteryVoltage = readBatteryVoltage();
  batteryPercentage = calculateBatteryPercentage(batteryVoltage);
  previousBatteryVoltage = batteryVoltage;
  previousTrendCheck = millis();

  previousModemCheck = millis();
  previousUpload = millis();
  previousSensorRead = millis();
  previousBatteryUpload = millis();

  Serial.println("System ready. Sensor ID: " + String(sensorID));
  Serial.println("Upload interval: 2 seconds | Settings: 10 seconds | Battery: 5 seconds");
  Serial.println("Dashboard: connect to FloodWatch-Diagnostics, then open 192.168.4.1");
}

// ============================================================
// MAIN LOOP
// ============================================================
void loop() {
  handleWebServer();
  connectWiFi();
  syncTimeIfWiFiAvailable();

  // Refresh modem status periodically rather than before every reading.
  if (millis() - previousModemCheck >= modemCheckInterval) {
    previousModemCheck = millis();
    updateCellularDiagnostics();
    uploadConnectionStatus();
  }

  if (millis() - previousSensorRead >= sensorInterval) {
    previousSensorRead = millis();
    sensorValid = readSensor();
    if (sensorValid) classifyFlood();
  }

  if (millis() - previousSettingsFetch >= settingsFetchInterval) {
    previousSettingsFetch = millis();
    fetchSensorSettings();
  }

  if (millis() - previousUpload >= uploadInterval) {
    previousUpload = millis();
    if (sensorValid) uploadFirebase();
    else Serial.println("Water upload skipped: invalid sensor reading.");
  }

  if (millis() - previousBatteryUpload >= batteryUploadInterval) {
    previousBatteryUpload = millis();
    uploadBatteryData();
  }

  yield();
}
