String jsonEscape(String s) {
  s.replace("\\", "\\\\");
  s.replace("\"", "\\\"");
  s.replace("\n", "\\n");
  s.replace("\r", "\\r");
  s.replace("\t", "\\t");
  return s;
}

String boolJSON(bool v) { return v ? "true" : "false"; }

bool isValidIP(const String& ip) {
  return ip.length() > 6 && ip != "0.0.0.0" && ip != "Unavailable";
}

void captureURC(const String& s) {
  if (s.indexOf("+SAPBR: 1: DEACT") >= 0 || s.indexOf("+SAPBR: 1,0") >= 0) {
    sawPdpDeact = true;
    bearerActive = false;
    lastModemURC = "PDP bearer deactivated";
  }
  if (s.indexOf("+CEREG:") >= 0) lastModemURC = "CEREG status update";
}

String lineAfter(const String& s, const String& prefix) {
  int p = s.indexOf(prefix);
  if (p < 0) return "";
  p += prefix.length();
  int e = s.indexOf('\n', p);
  if (e < 0) e = s.length();
  String v = s.substring(p, e);
  v.trim();
  return v;
}

// ============================================================
// AIR780E AT COMMAND HELPERS
// ============================================================
bool sendAT(const String& cmd, uint32_t timeoutMs = 5000, String* result = nullptr) {
  while (airSerial.available()) airSerial.read();
  Serial.println();
  Serial.println(">> " + cmd);
  airSerial.println(cmd);

  String response;
  uint32_t start = millis();
  bool done = false;
  bool ok = false;

  while (millis() - start < timeoutMs) {
    while (airSerial.available()) {
      char c = (char)airSerial.read();
      Serial.write(c);
      response += c;
      if (response.endsWith("\r\nOK\r\n") || response.endsWith("\nOK\n") || response.endsWith("\rOK\r")) {
        done = true; ok = true; break;
      }
      if (response.indexOf("\r\nERROR\r\n") >= 0 || response.indexOf("+CME ERROR:") >= 0) {
        done = true; ok = false; break;
      }
      if (response.length() > 6000) response.remove(0, 3000);
    }
    if (done) break;
    yield();
  }
  captureURC(response);
  if (result) *result = response;
  if (!done) Serial.println("[MODEM TIMEOUT] " + cmd);
  return done && ok;
}

bool waitForText(const String& token, uint32_t timeoutMs, String& response) {
  response = "";
  uint32_t start = millis();
  while (millis() - start < timeoutMs) {
    while (airSerial.available()) {
      char c = (char)airSerial.read();
      Serial.write(c);
      response += c;
      if (response.indexOf(token) >= 0) { captureURC(response); return true; }
      if (response.length() > 7000) response.remove(0, 3500);
    }
    yield();
  }
  captureURC(response);
  return false;
}

bool waitHTTPAction(int& status, int& dataLen, String& full) {
  full = ""; status = 0; dataLen = 0;
  int tokenPos = -1;
  int lineEnd = -1;
  uint32_t start = millis();
  while (millis() - start < 75000UL) {
    while (airSerial.available()) {
      char c = (char)airSerial.read();
      Serial.write(c);
      full += c;
      if (tokenPos < 0) {
        int found = full.indexOf("+HTTPACTION:");
        if (found >= 0) tokenPos = found;
      } else if (c == '\n') {
        lineEnd = (int)full.length() - 1;
        break;
      }
      if (full.length() > 7000) {
        if (tokenPos >= 0) { full.remove(0, tokenPos); tokenPos = 0; }
        else full.remove(0, 3500);
      }
    }
    if (lineEnd >= 0) break;
    yield();
  }
  captureURC(full);
  if (tokenPos < 0 || lineEnd < 0) return false;
  String line = full.substring(tokenPos, lineEnd);
  line.trim();
  int colon = line.indexOf(':');
  int c1 = line.indexOf(',', colon + 1);
  int c2 = line.indexOf(',', c1 + 1);
  if (colon < 0 || c1 < 0 || c2 < 0) return false;
  String st = line.substring(c1 + 1, c2);
  String len = line.substring(c2 + 1);
  st.trim(); len.trim();
  status = st.toInt(); dataLen = len.toInt();
  Serial.println("Parsed HTTP status=" + String(status) + ", response bytes=" + String(dataLen));
  return true;
}

// ============================================================
// MODEM DIAGNOSTICS
// ============================================================
void checkSIM() {
  String r;
  simDetected = false; imsi = "Unavailable"; carrier = "Unknown";
  if (sendAT("AT+CPIN?", 5000, &r) && r.indexOf("READY") >= 0) simDetected = true;
  if (!simDetected) { carrier = "No SIM / not ready"; return; }
  if (sendAT("AT+CIMI", 6000, &r)) {
    for (int i = 0; i < (int)r.length(); i++) {
      if (!isDigit(r[i])) continue;
      int j = i;
      while (j < (int)r.length() && isDigit(r[j])) j++;
      if (j - i >= 14 && j - i <= 16) { imsi = r.substring(i, j); break; }
      i = j;
    }
  }
  if (imsi.startsWith("51502")) carrier = "Globe (IMSI prefix)";
  else if (imsi.startsWith("51503")) carrier = "Smart (IMSI prefix)";
}

void checkSignal() {
  String r; signalQuality = "Unknown"; signalPercent = -1;
  if (!sendAT("AT+CSQ", 5000, &r)) return;
  int p = r.indexOf("+CSQ:");
  int comma = (p >= 0) ? r.indexOf(',', p) : -1;
  if (p < 0 || comma < 0) return;
  String n = r.substring(p + 5, comma); n.trim();
  int v = n.toInt();
  if (v == 99 || v < 0 || v > 31) return;
  signalQuality = String(v);
  signalPercent = (v * 100) / 31;
}

void checkRegistration() {
  String r; networkRegistered = false; registrationStatus = "Unknown";
  if (!sendAT("AT+CEREG?", 5000, &r)) return;
  String line = lineAfter(r, "+CEREG:");
  if (!line.length()) return;
  int comma = line.indexOf(',');
  String st = (comma >= 0) ? line.substring(comma + 1) : line;
  int next = st.indexOf(',');
  if (next >= 0) st = st.substring(0, next);
  st.trim();
  int v = st.toInt();
  if (v == 1) { registrationStatus = "Home network"; networkRegistered = true; }
  else if (v == 5) { registrationStatus = "Roaming"; networkRegistered = true; }
  else if (v == 2) registrationStatus = "Searching";
  else if (v == 3) registrationStatus = "Registration denied";
  else if (v == 0) registrationStatus = "Not registered";
  else registrationStatus = "Unknown (" + st + ")";
}

void checkPacketAttachment() {
  String r; packetAttached = false;
  if (sendAT("AT+CGATT?", 5000, &r)) packetAttached = (r.indexOf("+CGATT: 1") >= 0);
}

void checkModemIP() {
  String r; modemIP = "Unavailable";
  if (sendAT("AT+CGPADDR=1", 5000, &r)) {
    String line = lineAfter(r, "+CGPADDR:");
    int comma = line.indexOf(',');
    if (comma >= 0) {
      String ip = line.substring(comma + 1);
      ip.replace("\"", ""); ip.trim();
      if (isValidIP(ip)) modemIP = ip;
    }
  }
}

void updateCellularDiagnostics() {
  checkSIM(); checkSignal(); checkRegistration(); checkPacketAttachment(); checkModemIP();
  cellularConnected = simDetected && networkRegistered && packetAttached && isValidIP(modemIP);
  Serial.println("CELLULAR: " + String(cellularConnected ? "AVAILABLE" : "NOT READY") +
                 " | " + carrier + " | Signal " + String(signalPercent) + "% | " + registrationStatus);
}

// ============================================================
// PDP BEARER
// ============================================================
bool ensureBearer(bool forceRebuild = false) {
  String r;
  if (forceRebuild || sawPdpDeact) {
    Serial.println("Rebuilding AIR780E PDP bearer...");
    sendAT("AT+HTTPTERM", 2500);
    sendAT("AT+SAPBR=0,1", 8000);
    delay(500);
    sawPdpDeact = false; bearerActive = false;
  } else if (sendAT("AT+SAPBR=2,1", 8000, &r)) {
    String line = lineAfter(r, "+SAPBR:");
    int c1 = line.indexOf(',');
    int c2 = line.indexOf(',', c1 + 1);
    if (c1 >= 0 && c2 >= 0) {
      String state = line.substring(c1 + 1, c2); state.trim();
      String ip = line.substring(c2 + 1); ip.replace("\"", ""); ip.trim();
      if (state == "1" && isValidIP(ip)) { bearerActive = true; modemIP = ip; return true; }
    }
  }
  if (!sendAT("AT+SAPBR=3,1,\"CONTYPE\",\"GPRS\"", 5000, &r)) {
    lastError = "SAPBR CONTYPE failed: " + r; return false;
  }
  if (!sendAT("AT+SAPBR=3,1,\"APN\",\"\"", 5000, &r)) {
    lastError = "SAPBR APN failed: " + r; return false;
  }
  sendAT("AT+SAPBR=1,1", 30000, &r); // Query state even if activation response is unusual.
  if (!sendAT("AT+SAPBR=2,1", 8000, &r)) { lastError = "SAPBR query failed"; bearerActive = false; return false; }
  String line = lineAfter(r, "+SAPBR:");
  int c1 = line.indexOf(',');
  int c2 = line.indexOf(',', c1 + 1);
  if (c1 >= 0 && c2 >= 0) {
    String state = line.substring(c1 + 1, c2); state.trim();
    String ip = line.substring(c2 + 1); ip.replace("\"", ""); ip.trim();
    bearerActive = (state == "1" && isValidIP(ip));
    if (bearerActive) modemIP = ip;
  }
  if (!bearerActive) lastError = "PDP bearer inactive or no SAPBR IP";
  return bearerActive;
}

// ============================================================
// AIR780E FIREBASE REQUEST
// method: GET, PUT, POST
// PUT uses POST + Firebase method-override query for AIR780E.
// ============================================================
bool cellularFirebaseRequest(const String& method, const String& url, const String& payload, String& responseBody) {
  responseBody = "";
  if (!cellularConnected) { lastError = "Cellular diagnostics not ready"; return false; }
  if (!ensureBearer(false)) return false;

  sendAT("AT+HTTPTERM", 2500);
  delay(200);
  if (!sendAT("AT+HTTPINIT", 12000)) { lastError = "HTTPINIT failed"; return false; }
  String r;
  if (!sendAT("AT+HTTPSSL=1", 10000, &r)) { lastError = "HTTPSSL failed: " + r; sendAT("AT+HTTPTERM", 2500); return false; }
  // TEST MODE: TLS encryption is on, certificate verification is off.
  sendAT("AT+SSLCFG=\"seclevel\",153,0", 5000);
  if (!sendAT("AT+HTTPPARA=\"CID\",1", 5000)) { lastError = "HTTP CID setup failed"; sendAT("AT+HTTPTERM", 2500); return false; }

  String requestURL = url;
  bool hasBody = (method == "PUT" || method == "POST");
  if (method == "PUT") requestURL += (requestURL.indexOf('?') >= 0 ? "&" : "?") + String("x-http-method-override=PUT");
  if (!sendAT("AT+HTTPPARA=\"URL\",\"" + requestURL + "\"", 15000)) {
    lastError = "HTTP URL setup failed"; sendAT("AT+HTTPTERM", 2500); return false;
  }
  if (!sendAT("AT+HTTPPARA=\"CONTENT\",\"application/json\"", 5000)) {
    lastError = "HTTP content type setup failed"; sendAT("AT+HTTPTERM", 2500); return false;
  }

  if (hasBody) {
    String dataCmd = "AT+HTTPDATA=" + String(payload.length()) + ",20000";
    Serial.println(">> " + dataCmd);
    airSerial.println(dataCmd);
    if (!waitForText("DOWNLOAD", 12000, r)) {
      lastError = "HTTPDATA prompt failed: " + r; sendAT("AT+HTTPTERM", 2500); return false;
    }
    airSerial.print(payload);
    if (!waitForText("OK", 25000, r)) {
      lastError = "Modem rejected HTTP body: " + r; sendAT("AT+HTTPTERM", 2500); return false;
    }
  }

  int action = (method == "GET") ? 0 : 1;
  Serial.println(">> AT+HTTPACTION=" + String(action));
  airSerial.println("AT+HTTPACTION=" + String(action));
  int status = 0, bytes = 0;
  String actionResponse;
  if (!waitHTTPAction(status, bytes, actionResponse)) {
    lastError = "HTTPACTION result timeout"; sendAT("AT+HTTPTERM", 2500); return false;
  }
  lastHTTPStatus = status;

  String readResponse;
  if (bytes > 0) {
    sendAT("AT+HTTPREAD", 15000, &readResponse);
    int header = readResponse.indexOf("+HTTPREAD:");
    if (header >= 0) {
      int bodyStart = readResponse.indexOf('\n', header);
      if (bodyStart >= 0) {
        bodyStart++;
        int bodyEnd = readResponse.lastIndexOf("\r\nOK");
        if (bodyEnd < bodyStart) bodyEnd = readResponse.lastIndexOf("\nOK");
        if (bodyEnd > bodyStart) responseBody = readResponse.substring(bodyStart, bodyEnd);
        else responseBody = readResponse.substring(bodyStart);
      }
    }
  }
  sendAT("AT+HTTPTERM", 3000);

  Serial.println("AIR780E HTTP status: " + String(status));
  if (status >= 200 && status < 300) { lastError = "None"; return true; }
  lastError = "Cellular HTTP status " + String(status);
  if (status == 601) lastError += " (network error)";
  else if (status == 603) lastError += " (DNS error)";
  else if (status == 605) lastError += " (TLS setup error)";
  else if (status == 606) lastError += " (TLS communication error)";
  return false;
}

// ============================================================
// WIFI FIREBASE REQUEST
// ============================================================
bool wifiFirebaseRequest(const String& method, const String& url, const String& payload, String& responseBody) {
  responseBody = "";
  if (WiFi.status() != WL_CONNECTED) return false;
  BearSSL::WiFiClientSecure client;
  client.setInsecure(); // Test mode; configure certificate validation for production.
  HTTPClient http;
  if (!http.begin(client, url)) { lastError = "WiFi HTTP begin failed"; return false; }
  http.addHeader("Content-Type", "application/json");
  http.setTimeout(15000);
  int code = -1;
  if (method == "GET") code = http.GET();
  else if (method == "PUT") code = http.PUT(payload);
  else if (method == "POST") code = http.POST(payload);
  if (code > 0) responseBody = http.getString();
  else lastError = "WiFi request failed: " + http.errorToString(code);
  http.end();
  lastHTTPStatus = code;
  if (code >= 200 && code < 300) { lastError = "None"; return true; }
  if (code > 0) lastError = "WiFi HTTP status " + String(code) + ": " + responseBody;
  return false;
}

// Every Firebase operation tries cellular first, then Wi-Fi backup.
bool firebaseRequest(const String& method, const String& url, const String& payload, String& responseBody) {
  if (cellularConnected) {
    activeConnection = "Cellular";
    if (cellularFirebaseRequest(method, url, payload, responseBody)) return true;
    Serial.println("Cellular Firebase request failed; trying Wi-Fi backup. " + lastError);
  }
  if (WiFi.status() != WL_CONNECTED) {
    uint32_t started = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - started < 12000UL) {
      wifiMulti.run(); handleWebServer(); delay(10); yield();
    }
  }
  if (WiFi.status() == WL_CONNECTED) {
    activeConnection = "WiFi";
    if (wifiFirebaseRequest(method, url, payload, responseBody)) return true;
  }
  return false;
}

// ============================================================
// WIFI BACKUP MANAGEMENT
// ============================================================
void connectWiFi() {
  if (WiFi.status() == WL_CONNECTED) return;
  if (millis() - previousWifiRetry < wifiRetryInterval) return;
  previousWifiRetry = millis();
  Serial.println("Checking Wi-Fi backup networks...");
  wifiMulti.run();
}

